# ─────────────────────────────────────────────────────────────────────────────
# MZN Unified Learning Platform — environment variables.
# Copy to .env for local development. NEVER commit real secrets.
# Every variable used anywhere in the codebase must be documented here.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: development | staging | production (also NODE_ENV)
APP_ENV=development
NODE_ENV=development

# Public base URL of the web portal (used in emails, QR codes, CORS, cookies)
APP_PUBLIC_URL=http://localhost:3000
# Base URL the web server uses to call the API from server components / proxy
API_INTERNAL_URL=http://localhost:4000
# Port bindings
API_PORT=4000
WEB_PORT=3000
WORKER_HEALTH_PORT=4100

# PostgreSQL (production: point at PgBouncer, add ?pgbouncer=true)
DATABASE_URL=postgresql://mzn:mzn_dev_only@127.0.0.1:55432/mzn
# Separate database used by integration tests (wiped by the test runner)
DATABASE_URL_TEST=postgresql://mzn:mzn_dev_only@127.0.0.1:55432/mzn_test

# Redis for rate limiting, caches and BullMQ. Required in staging/production.
# Leave empty in local development to use the in-process fallback (single instance only).
REDIS_URL=

# Field-level encryption: base64 of 32 random bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=k1
# Decrypt-only previous keys during rotation: "k0:base64,k_old:base64"
APP_ENCRYPTION_KEYS_OLD=
# HMAC secret for opaque tokens / webhook-free signatures (>= 32 random bytes, base64)
SESSION_SECRET=

# Session lifetime (minutes) and idle timeout (minutes)
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=60
# Set to true behind TLS (always true in staging/production)
COOKIE_SECURE=false

# Current versions of legal texts users must accept at registration (TODO(HUMAN): legal texts)
PRIVACY_NOTICE_VERSION=draft-2026-11
TERMS_VERSION=draft-2026-11

# Email (SMTP). EMAIL_PROVIDER=mock logs messages to IntegrationLog and the dev mailbox only.
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MZN Training <no-reply@example.invalid>"

# SMS provider (TODO(HUMAN): choose Saudi provider). Only "mock" exists today.
SMS_PROVIDER=mock

# Seed options (development/test only — ignored when NODE_ENV=production)
SEED_DEV_USERS=false
SEED_DEV_PASSWORD=
# Base32 TOTP secret shared by dev staff accounts so e2e tests can complete MFA
SEED_DEV_TOTP_SECRET=
SEED_RESET_ROLES=false

# Observability
LOG_LEVEL=info
SENTRY_DSN=
METRICS_ENABLED=true
# Bearer token required to scrape /metrics (empty = metrics endpoint disabled)
METRICS_TOKEN=

# Web (browser-exposed values must be prefixed NEXT_PUBLIC_ and contain no secrets)
NEXT_PUBLIC_APP_NAME="MZN"
