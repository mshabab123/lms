    "@nestjs/swagger": "11.4.8",
    "@sentry/node": "10.78.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "7.0.13",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
