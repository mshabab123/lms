{
  "name": "@mzn/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsup src/main.ts --format cjs --clean --external @mzn/db --external @prisma/client",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mzn/db": "workspace:*",
    "pino": "9.14.0",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
