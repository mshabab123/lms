{
  "name": "mzn-learning-platform",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @mzn/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mzn/db generate",
    "db:migrate": "pnpm --filter @mzn/db migrate:dev",
    "db:deploy": "pnpm --filter @mzn/db migrate:deploy",
    "db:seed": "pnpm --filter @mzn/db seed",
    "devdb:start": "bash scripts/dev-db.sh start",
    "devdb:stop": "bash scripts/dev-db.sh stop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
