{
  "name": "@mzn/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsup src/index.ts --format cjs,esm --dts --clean --external @prisma/client",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force --skip-seed",
    "seed": "tsx src/seed.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@mzn/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "otplib": "12.0.1"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
